rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========== AUTHENTICATION RULES ==========
    // Users collection - authenticated users only
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null; // Other users can read profiles

      // Blocked users subcollection
      match /blocked_users/{targetUserId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Reported posts subcollection
      match /reported_posts/{postId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ========== OTP VERIFICATION ==========
    match /otp_verifications/{document=**} {
      allow write: if request.auth == null; // Anyone can request OTP
      allow read, write: if request.auth != null;
    }

    // ========== PERFORMANCES/LIVE SESSIONS ==========
    match /performances/{performanceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.artist_id == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.artist_id == request.auth.uid;
    }

    // Live viewers tracking
    match /performances/{performanceId}/viewers/{viewerId} {
      allow read, write: if request.auth != null;
    }

    // Performance likes
    match /performances/{performanceId}/likes/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }

    // Performance saves
    match /performances/{performanceId}/saves/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }

    // Performance views
    match /performances/{performanceId}/views/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.viewer_id == request.auth.uid;
    }

    // Live stream chat messages
    match /performances/{performanceId}/chats/{chatId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
    }

    // User swipes
    match /users/{userId}/swipes/{postId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ========== COMMUNITY ==========
    match /community_posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      // Allow any authenticated user to update (for likes, reply counts)
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // Comments subcollection under community_posts
    match /community_posts/{postId}/comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      // Allow any authenticated user to update (for likes) or delete their own comments
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.author_id == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.author_id == request.auth.uid;
    }

    // Comments on posts
    match /posts/{postId}/comments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.author_id == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.author_id == request.auth.uid;
    }

    // Likes
    match /posts/{postId}/likes/{likeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
      allow delete: if request.auth != null && resource.data.user_id == request.auth.uid;
    }

    // Discussions
    match /discussions/{discussionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.author_id == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.author_id == request.auth.uid;
    }

    // Discussion replies
    match /discussions/{discussionId}/replies/{replyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.author_id == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.author_id == request.auth.uid;
    }

    // ========== CHAT ==========
    match /chats/{chatId} {
      allow read: if request.auth != null && (resource.data.user1_id == request.auth.uid || resource.data.user2_id == request.auth.uid);
      allow create: if request.auth != null;
    }

    match /chats/{chatId}/messages/{messageId} {
      allow read: if request.auth != null && (get(/databases/$(database)/documents/chats/$(chatId)).data.user1_id == request.auth.uid || get(/databases/$(database)/documents/chats/$(chatId)).data.user2_id == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.sender_id == request.auth.uid;
    }

    // ========== NOTIFICATIONS ==========
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if true;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ========== PREFERENCES ==========
    match /preferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ========== SAFETY & MODERATION ==========
    match /blocks/{blockId} {
      allow read, write: if request.auth != null;
    }

    match /reports/{reportId} {
      allow read, create, write: if request.auth != null;
    }

    match /shadow_bans/{banId} {
      allow read, write: if request.auth != null;
    }

    // ========== HELP, FAQ & TRACKS ==========
    match /help_topics/{topicId} {
      allow read: if request.auth != null;
    }

    match /faqs/{faqId} {
      allow read: if request.auth != null;
    }

    match /tracks/{trackId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ========== TRANSACTIONS ==========
    match /transactions/{transactionId} {
      allow read: if request.auth != null && (
        resource.data.artist_id == request.auth.uid ||
        resource.data.user_id == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.artistId == request.auth.uid
      );
      allow write: if false; // Writes must go through Cloud Functions
    }

    // ========== DEFAULT DENY ==========
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
